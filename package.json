{
  "name": "nanotimer",
  "productName": "nanotimer",
  "version": "1.0.0",
  "private": true,
  "description": "nanotimer - a frameless, transparent floating timer widget for Windows.",
  "author": "Alan",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js",
    "check": "node --check scripts/start.js && node --check src/main/main.js && node --check src/main/window-snap.js && node --check src/main/preload.js && node --check src/renderer/renderer.js",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "package:win": "npm run pack && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-launcher.ps1",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.alan.nanotimer",
    "productName": "nanotimer",
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "nanotimer"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "copyright": "Copyright © 2026 Alan",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "nanotimer",
      "artifactName": "${productName}-${version}-setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alanchan20121201-prog",
        "repo": "nanotimer",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "license": "MIT",
  "keywords": [
    "electron",
    "timer",
    "countdown",
    "stopwatch",
    "widget",
    "desktop",
    "productivity"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alanchan20121201-prog/nanotimer.git"
  },
  "homepage": "https://github.com/alanchan20121201-prog/nanotimer",
  "bugs": {
    "url": "https://github.com/alanchan20121201-prog/nanotimer/issues"
  }
}
